---
import { getActiveCity } from '../lib/city';

const city = getActiveCity();
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div>
      <div class="brand" style="margin-bottom:14px">
        <span class="brand-mark">{city.brandMark}</span>
        <span>{city.brandName}</span>
      </div>
      <p>
        One quiet, well-edited daily for the city. News, events and gold rates — in English, every morning. No pop-ups,
        no autoplay, no paywall.
      </p>
    </div>
    <div>
      <h5>Read</h5>
      <ul>
        <li><a href="/news">Today's news</a></li>
        <li><a href="/news">Civic & metro</a></li>
      </ul>
    </div>
    <div>
      <h5>Do</h5>
      <ul>
        <li><a href="/events">This weekend</a></li>
        <li><a href="/events">Sports</a></li>
        <li><a href="/events">Music & magic</a></li>
        <li><a href="/events">Food & drink</a></li>
      </ul>
    </div>
    <div>
      <h5>Track</h5>
      <ul>
        <li><a href="/prices">Gold rate</a></li>
        <li><a href="/prices">Silver rate</a></li>
        <li><a href="/prices">7-day history</a></li>
        <li><a href="/prices">Charts</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-base">
    <span>© {year} {city.brandName}. All times {city.timezone}.</span>
    <span>Made in {city.name}</span>
  </div>
</footer>
