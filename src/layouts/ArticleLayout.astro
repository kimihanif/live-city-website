---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  active?: 'news' | 'events';
  ogImage?: string | null;
}

const { title, description, active = 'news', ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} active={active} ogImage={ogImage}>
  <slot />
</BaseLayout>
