---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { safeListEvents } from '../../lib/appwrite';
import { getActiveCity } from '../../lib/city';
import { EventFeatureSplit } from '../../components/EventFeatureSplit';
import { EventRow } from '../../components/EventRow';
import { ChipFilter } from '../../components/ChipFilter';

const city = getActiveCity();
const events = await safeListEvents(city.id, 100);

const categories = ['All', ...Array.from(new Set(events.map((e) => e.category)))];
const featured = events[0];
const rest = events.slice(1);
---

<BaseLayout
  title={`What's on in ${city.name} | ${city.brandName}`}
  description={city.eventsBlurb}
  active="events"
>
  <section class="wrap" style="padding-top:36px; padding-bottom:32px">
    <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:18px">
      <h1 style="font-size:48px; font-weight:800; letter-spacing:-1.4px; margin:0; line-height:1">Events</h1>
      <span style="font-size:13px; color:var(--ink-4); font-weight:500">
        {events.length} {events.length === 1 ? 'event' : 'events'} listed
      </span>
    </div>

    {events.length > 0 && <ChipFilter client:load categories={categories} selector="[data-event-filter]" />}

    {
      featured && (
        <div data-event-filter data-category={featured.category}>
          <EventFeatureSplit event={featured} />
        </div>
      )
    }

    {
      rest.length > 0 && (
        <div class="event-list">
          {rest.map((ev) => (
            <div data-event-filter data-category={ev.category}>
              <EventRow event={ev} />
            </div>
          ))}
        </div>
      )
    }

    {
      events.length === 0 && (
        <div class="card" style="padding:40px; text-align:center">
          <h3 style="font-size:22px; font-weight:800; letter-spacing:-0.5px; margin:0 0 8px">
            No events listed for this week
          </h3>
          <p style="color:var(--ink-3); margin:0">Check back Friday morning — we curate the weekend slate.</p>
        </div>
      )
    }
  </section>
</BaseLayout>
