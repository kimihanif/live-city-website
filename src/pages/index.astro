---
import BaseLayout from '../layouts/BaseLayout.astro';
import { safeListNewsArticles, safeListEvents, safeListMetalPrices } from '../lib/appwrite';
import { getActiveCity } from '../lib/city';
import { Sparkline } from '../components/Sparkline';
import { LiveTicker } from '../components/LiveTicker';
import { NewsFeature } from '../components/NewsFeature';
import { NewsRow } from '../components/NewsRow';
import { NewsCard } from '../components/NewsCard';
import { EventCard } from '../components/EventCard';
import { PriceCard } from '../components/PriceCard';
import { ArrowIcon } from '../components/Icon';
import { formatINR } from '../lib/format';

const city = getActiveCity();

const [news, events, prices] = await Promise.all([
  safeListNewsArticles(city.id),
  safeListEvents(city.id, 10),
  safeListMetalPrices(city.id, 30),
]);

const featured = news[0];
const sideNews = news.slice(1, 4);
const moreNews = news.slice(4, 7);
const topEvents = events.slice(0, 3);

const ascPrices = [...prices].reverse();
const goldHistory = ascPrices.map((p) => p.gold_22k_price);
const silverHistory = ascPrices.map((p) => p.silver_price);
const latestPrice = prices[0];
const prevPrice = prices[1];
const oldestPrice = ascPrices[0];

const goldDelta = latestPrice && prevPrice ? latestPrice.gold_22k_price - prevPrice.gold_22k_price : 0;
const silverDelta = latestPrice && prevPrice ? latestPrice.silver_price - prevPrice.silver_price : 0;
---

<BaseLayout active="home">
  <section class="hero wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow"><span class="dot-g"></span> {city.brandName}</span>
        <h1 class="display">All of <span class="accent">{city.heroHomeAccent}</span>,<br />in one read.</h1>
        <p class="tagline">
          News that affects your day. Events worth showing up for. The day's gold rate. In English — every morning, no
          clutter.
        </p>
        <div class="hero-cta">
          <a class="btn-primary" href="/news" style="text-decoration:none">Read today's news <ArrowIcon /></a>
          <a class="btn-ghost" href="/events" style="text-decoration:none">What's on this weekend</a>
        </div>
      </div>
      <div class="hero-rail">
        <LiveTicker
          client:visible
          goldPrice={latestPrice?.gold_22k_price ?? null}
          goldDelta={goldDelta}
          silverPrice={latestPrice?.silver_price ?? null}
          silverDelta={silverDelta}
          state={city.state}
          topVenue={city.venues[0]}
          topHeadline={featured?.headline ?? null}
        />
        {
          latestPrice && (
            <div class="card" style="padding:18px 22px; display:flex; align-items:center; gap:18px">
              <div style="display:flex; flex-direction:column; gap:4px; flex:1">
                <span class="eyebrow" style="color:var(--ink-4)">Gold 22K · per gram</span>
                <span style="font-size:24px; font-weight:800; letter-spacing:-0.6px">
                  ₹{formatINR(latestPrice.gold_22k_price)}
                  {goldDelta !== 0 && (
                    <span
                      style={`font-size:12px; color:${goldDelta > 0 ? 'var(--green)' : 'var(--red)'}; font-weight:700; margin-left:6px`}
                    >
                      {goldDelta > 0 ? '▴' : '▾'} ₹{Math.abs(Math.round(goldDelta))}
                    </span>
                  )}
                </span>
              </div>
              <Sparkline data={goldHistory.slice(-14)} width={120} height={40} />
              <a class="section-link" href="/prices">
                Prices <ArrowIcon />
              </a>
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="section wrap">
        <div class="section-meta">
          <div>
            <span class="eyebrow">
              <span class="dot-g" /> Today's news
            </span>
            <h2 class="section-title" style="margin-top:10px">
              The things that <span class="accent">matter</span> today.
            </h2>
            <p style="margin-top:14px">
              Edited by humans in {city.name}. We pick what affects your commute, your wallet, your weekend — not what
              trends.
            </p>
          </div>
          <a class="section-link" href="/news">
            All news <ArrowIcon />
          </a>
        </div>

        <div class="news-hero">
          {featured && <NewsFeature article={featured} />}
          <div class="news-side">
            {sideNews.map((n) => (
              <NewsRow article={n} />
            ))}
          </div>
        </div>

        {moreNews.length > 0 && (
          <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; margin-top:16px">
            {moreNews.map((n) => (
              <NewsCard article={n} />
            ))}
          </div>
        )}
      </section>
    )
  }

  {
    news.length === 0 && (
      <section class="section wrap">
        <div class="card" style="padding:32px; text-align:center">
          <span class="eyebrow">
            <span class="dot-g" /> Today's edition
          </span>
          <h2 class="section-title" style="margin-top:10px">
            Today's news publishes at <span class="accent">7 AM IST</span>.
          </h2>
          <p style="margin-top:14px">
            The {city.brandName} desk is editing this morning's stories. Check back shortly.
          </p>
        </div>
      </section>
    )
  }

  {
    topEvents.length > 0 && (
      <section class="section wrap" style="padding-top:32px">
        <div class="section-meta">
          <div>
            <span class="eyebrow">
              <span class="dot-g" /> What's on
            </span>
            <h2 class="section-title" style="margin-top:10px">
              Worth <span class="accent">showing up</span> for.
            </h2>
            <p style="margin-top:14px">{city.eventsBlurb}</p>
          </div>
          <a class="section-link" href="/events">
            All events <ArrowIcon />
          </a>
        </div>
        <div class="event-grid">
          {topEvents.map((ev) => (
            <EventCard event={ev} />
          ))}
        </div>
      </section>
    )
  }

  {
    latestPrice && (
      <section class="section wrap" style="padding-top:32px">
        <div class="section-meta">
          <div>
            <span class="eyebrow">
              <span class="dot-g" /> Live rates
            </span>
            <h2 class="section-title" style="margin-top:10px">
              {city.heroPricesLine1.replace(/,$/, '')}, by the <span class="accent">gram</span>.
            </h2>
            <p style="margin-top:14px">22K and silver — verified daily from {city.goldSource}, before 10 AM.</p>
          </div>
          <a class="section-link" href="/prices">
            Full charts <ArrowIcon />
          </a>
        </div>

        <div class="prices-grid">
          <a href="/prices" style="text-decoration:none; color:inherit; display:block">
            <PriceCard
              metal="gold"
              current={latestPrice.gold_22k_price}
              prev={prevPrice?.gold_22k_price}
              asOf={latestPrice.price_date}
              history={goldHistory}
              reference30dAgo={oldestPrice?.gold_22k_price}
              hover
              showSparkline
            />
          </a>
          <a href="/prices" style="text-decoration:none; color:inherit; display:block">
            <PriceCard
              metal="silver"
              current={latestPrice.silver_price}
              prev={prevPrice?.silver_price}
              asOf={latestPrice.price_date}
              history={silverHistory}
              reference30dAgo={oldestPrice?.silver_price}
              hover
              showSparkline
            />
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
