---
import BaseLayout from '../layouts/BaseLayout.astro';
import { safeListNewsArticles, safeListEvents, safeListMetalPrices } from '../lib/appwrite';
import { getActiveCity } from '../lib/city';
import { NewsFeature } from '../components/NewsFeature';
import { NewsRow } from '../components/NewsRow';
import { NewsCard } from '../components/NewsCard';
import { EventCard } from '../components/EventCard';
import { PriceCard } from '../components/PriceCard';
import { ArrowIcon } from '../components/Icon';

const city = getActiveCity();

const [news, events, prices] = await Promise.all([
  safeListNewsArticles(city.id),
  safeListEvents(city.id, 10),
  safeListMetalPrices(city.id, 30),
]);

const featured = news[0];
const sideNews = news.slice(1, 4);
const moreNews = news.slice(4, 7);
const topEvents = events.slice(0, 3);

const ascPrices = [...prices].reverse();
const goldHistory = ascPrices.map((p) => p.gold_22k_price);
const silverHistory = ascPrices.map((p) => p.silver_price);
const latestPrice = prices[0];
const prevPrice = prices[1];
const oldestPrice = ascPrices[0];
---

<BaseLayout active="home">
  {
    news.length > 0 ? (
      <section class="wrap" style="padding-top:36px; padding-bottom:32px">
        <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:18px">
          <h2 style="font-size:40px; font-weight:800; letter-spacing:-1.2px; margin:0; line-height:1">News</h2>
          <a class="section-link" href="/news">
            All news <ArrowIcon />
          </a>
        </div>

        <div class="news-hero">
          {featured && <NewsFeature article={featured} showSummary />}
          <div class="news-side">
            {sideNews.map((n) => (
              <NewsRow article={n} />
            ))}
          </div>
        </div>

        {moreNews.length > 0 && (
          <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; margin-top:16px">
            {moreNews.map((n) => (
              <NewsCard article={n} />
            ))}
          </div>
        )}
      </section>
    ) : (
      <section class="wrap" style="padding-top:48px; padding-bottom:32px">
        <div class="card" style="padding:32px; text-align:center">
          <h2 style="font-size:32px; font-weight:800; letter-spacing:-0.8px; margin:0 0 10px">
            Today's news publishes at 7&nbsp;AM&nbsp;IST
          </h2>
          <p style="margin:0; color:var(--ink-3)">
            The {city.brandName} desk is editing this morning's stories. Check back shortly.
          </p>
        </div>
      </section>
    )
  }

  {
    topEvents.length > 0 && (
      <section class="wrap" style="padding-top:16px; padding-bottom:32px">
        <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:18px">
          <h2 style="font-size:40px; font-weight:800; letter-spacing:-1.2px; margin:0; line-height:1">Events</h2>
          <a class="section-link" href="/events">
            All events <ArrowIcon />
          </a>
        </div>
        <div class="event-grid">
          {topEvents.map((ev) => (
            <EventCard event={ev} />
          ))}
        </div>
      </section>
    )
  }

  {
    latestPrice && (
      <section class="wrap" style="padding-top:16px; padding-bottom:48px">
        <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:18px">
          <h2 style="font-size:40px; font-weight:800; letter-spacing:-1.2px; margin:0; line-height:1">Prices</h2>
          <a class="section-link" href="/prices">
            Full charts <ArrowIcon />
          </a>
        </div>

        <div class="prices-grid">
          <a href="/prices" style="text-decoration:none; color:inherit; display:block">
            <PriceCard
              metal="gold"
              current={latestPrice.gold_22k_price}
              prev={prevPrice?.gold_22k_price}
              asOf={latestPrice.price_date}
              history={goldHistory}
              reference30dAgo={oldestPrice?.gold_22k_price}
              hover
              showSparkline
            />
          </a>
          <a href="/prices" style="text-decoration:none; color:inherit; display:block">
            <PriceCard
              metal="silver"
              current={latestPrice.silver_price}
              prev={prevPrice?.silver_price}
              asOf={latestPrice.price_date}
              history={silverHistory}
              reference30dAgo={oldestPrice?.silver_price}
              hover
              showSparkline
            />
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
