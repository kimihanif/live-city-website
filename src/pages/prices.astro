---
import BaseLayout from '../layouts/BaseLayout.astro';
import { safeListMetalPrices } from '../lib/appwrite';
import { getActiveCity } from '../lib/city';
import { MetalToggle } from '../components/MetalToggle';

const city = getActiveCity();
const prices = await safeListMetalPrices(city.id, 365);

const ascending = [...prices].reverse();
const series = ascending.map((p) => ({
  date: p.price_date,
  gold: p.gold_22k_price,
  silver: p.silver_price,
}));
---

<BaseLayout
  title={`Gold & Silver rates in ${city.name} | ${city.brandName}`}
  description={`Live 22K gold and silver rates from ${city.goldSource}. Verified daily before 10 AM.`}
  active="prices"
>
  <section class="wrap" style="padding-top:36px; padding-bottom:32px">
    <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:18px">
      <h1 style="font-size:48px; font-weight:800; letter-spacing:-1.4px; margin:0; line-height:1">Prices</h1>
      <span style="font-size:13px; color:var(--ink-4); font-weight:500">
        Sourced from {city.goldSource}
      </span>
    </div>

    {
      series.length > 0 ? (
        <MetalToggle client:load series={series} />
      ) : (
        <div class="card" style="padding:40px; text-align:center">
          <h3 style="font-size:22px; font-weight:800; letter-spacing:-0.5px; margin:0 0 8px">
            No rates published yet today
          </h3>
          <p style="color:var(--ink-3); margin:0">
            Morning rates from {city.goldSource} land before 10 AM IST.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
